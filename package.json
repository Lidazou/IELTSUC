{
  "name": "ieltsuc",
  "version": "1.3.1",
  "description": "IELTSUC personal local IELTS companion",
  "main": "main.cjs",
  "author": "IELTSUC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win dir --x64",
    "portable": "electron-builder --win portable --x64",
    "postinstall": "node scripts/prepare-ocr.cjs"
  },
  "dependencies": {
    "mammoth": "^1.9.1",
    "pdf-parse": "1.1.1",
    "sql.js": "^1.13.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.ieltsuc.app",
    "productName": "IELTSUC",
    "electronVersion": "44.4.5",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "ui/**/*",
      "assets/ocr-bundled/**/*",
      "node_modules/**/*",
      "package.json",
      "curriculum.cjs",
      "assets/curriculum/catalog.json",
      "assets/icon.*",
      "THIRD_PARTY_NOTICES.md",
      "assets/curriculum/personal.json"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js*/**/*",
      "assets/ocr-bundled/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "IELTSUC-${version}-win-x64.exe"
    },
    "compression": "normal",
    "extraResources": []
  }
}